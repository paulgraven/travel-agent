# Configure these in Vercel Project Settings > Environment Variables.
# Never commit actual values.
NEXTAUTH_URL=https://travel-agent-smoky.vercel.app
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: review and accept RTD GTFS terms before setting true
RTD_GTFS_LICENSE_ACCEPTED=false
# Optional: required to activate authenticated MCP endpoint
MCP_API_KEY=

# Server-only. Enable Google Maps Routes API and billing, restrict key to Routes API.
GOOGLE_MAPS_API_KEY=
